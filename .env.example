# guitarRot cloud features (accounts now; progress sync, leaderboard and
# analytics later). Copy this file to `.env.local` (git-ignored) and fill it in.
# Vite reads it at build time, so restart `npm run dev` / rebuild after changing it.
#
# Leave every FIREBASE variable out and the app is exactly the offline app it
# always was: no account UI, no network calls, no Firebase code downloaded.
# The cloud features switch on only when ALL FIVE required values are set.

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# (These identify the project; they are not secrets. Access is decided by the
# security rules and by Authentication's authorized domains.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional. Switches on opt-in usage analytics (needs Google Analytics enabled on
# the project; it is shown in the web app's config as `measurementId`). Without it
# the app asks no consent question and loads no analytics code. See docs/ACCOUNTS.md.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. 1 shows "Continue with Apple" next to "Continue with Google". Leave it out
# until Sign in with Apple is set up in Firebase (it needs a paid Apple Developer
# account, a Services ID and a key: docs/ACCOUNTS.md, "Apple sign-in"); a button
# that cannot work is worse than none. It also works with the emulators below
# (`VITE_AUTH_APPLE=1 npm run dev:emulators`), where the Auth emulator fakes Apple.
# VITE_AUTH_APPLE=1

# Development only. 1 = ignore the values above and talk to the local Firebase
# Emulator Suite (Auth 127.0.0.1:9099, Firestore 127.0.0.1:8080) with the demo
# project "demo-guitarrot". Start the emulators with `npm run emulators`, the
# app with `npm run dev:emulators`. Never set this in a deployed build.
# VITE_FIREBASE_EMULATORS=1
