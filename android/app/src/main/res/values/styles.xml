<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- The theme the activity runs in once the splash is gone (BridgeActivity
         sets it in onCreate, and the splash's postSplashScreenTheme points at it).
         On Android 15+ the app is edge-to-edge whatever we ask for, so the strips
         behind the status and navigation bars are not painted by the web view:
         they show the window background, and Capacitor's SystemBars plugin also
         copies windowBackground onto the decor view. It has to be a plain colour,
         not a drawable, because the plugin reads it as a colour int. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ground</item>
        <!-- Android 14 and older still honour these; 15+ ignores them. -->
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
    </style>


    <!-- Launch theme. On Android 12+ the system draws the splash from this theme
         before any of our code runs; core-splashscreen back-ports the same look
         to older versions. Without these items it falls back to the system
         background colour and the default Android robot icon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
